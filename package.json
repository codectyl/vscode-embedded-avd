{
  "name": "vscode-embedded-avd",
  "displayName": "Embedded AVD",
  "description": "Extension to embed Android Emulator in VSCode instead of running in a separate window.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.103.0"
  },
  "publisher": "codectyl",
  "categories": ["Other"],
  "activationEvents": [],
  "author": {
    "name": "Codectyl",
    "email": "codectyl@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://www.github.com/codectyl/vscode-embedded-avd"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "embeddedAvd.start",
        "title": "Embedded AVD: Start"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Embedded Android Emulator",
      "properties": {
        "embeddedAvd.emulatorPath": {
          "type": "string",
          "default": "emulator",
          "description": "Path to the Android Emulator binary."
        }
      }
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.7.0",
    "@grpc/grpc-js": "^1.9.7",
    "ws": "^8.19.0"
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "rspack",
    "watch": "rspack --watch",
    "package": "rspack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "format": "biome format --write .",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "biome check .",
    "test": "vscode-test",
    "proto:generate": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --ts_proto_opt=esModuleInterop=true,outputServices=grpc-js -I ./src/proto ./src/proto/emulator_controller.proto",
    "biome:fix": "biome check --write ."
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@biomejs/biome": "1.9.4",
    "@rspack/cli": "^1.5.3",
    "@rspack/core": "^1.5.3",
    "@tailwindcss/postcss": "^4.1.13",
    "@tsconfig/strictest": "^2.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "babel-loader": "^10.0.0",
    "babel-preset-solid": "^1.9.9",
    "css-loader": "^7.1.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "solid-js": "^1.9.9",
    "solid-refresh": "^0.7.5",
    "solid-styled-jsx": "^0.27.1",
    "tailwindcss": "^4.1.13",
    "ts-loader": "^9.5.4",
    "ts-proto": "^2.7.7",
    "typescript": "^5.9.2",
    "worker-rspack-loader": "^3.1.2"
  }
}
